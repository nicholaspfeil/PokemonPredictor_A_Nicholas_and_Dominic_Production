        "\n",
        "    # --- NEW: volume-based features (genuinely new signal) ---\n",
        "    recent_vol = window_v[-30:]\n",
        "    older_vol = window_v[-60:-30]\n",
        "    avg_recent_vol = np.mean(recent_vol) if recent_vol else 0\n",
        "    avg_older_vol = np.mean(older_vol) if older_vol else 0\n",
        "    vol_trend = pct_change(avg_older_vol + 1, avg_recent_vol + 1)  # is trading picking up?\n",
        "\n",
        "    # --- NEW: acceleration (is the trend speeding up or slowing down?) ---\n",
        "    momentum_recent = pct_change(p7, current)\n",
        "    momentum_older = pct_change(p30, p7)\n",
        "    acceleration = momentum_recent - momentum_older\n",
        "\n",
        "    return [\n",
        "        pct_change(p7, current),      # 7d momentum\n",
        "        pct_change(p30, current),     # 30d trend\n",
        "        pct_change(p60, current),     # 60d trend\n",
        "        volatility * 100,             # volatility\n",
        "        np.log(current + 1),          # price level\n",
        "        avg_recent_vol,               # NEW: recent trading volume\n",
        "        vol_trend,                    # NEW: is volume rising?\n",
        "        acceleration,                 # NEW: trend acceleration\n",
        "        rarity_to_num[rarity],        # NEW: rarity\n",
        "    ]\n",
        "\n",
        "X, y = [], []\n",
        "for card in cards:\n",
        "    prices, volumes = card[\"prices\"], card[\"volumes\"]\n",
        "    cutoff = len(prices) - HORIZON_DAYS\n",
