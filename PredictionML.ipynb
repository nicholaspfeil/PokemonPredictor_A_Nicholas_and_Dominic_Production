        "HORIZON_DAYS = 60\n",
        "MIN_HISTORY = 150\n",
        "MIN_PRICE = 1.00\n",
        "\n",
        "with open(\"price_history_dataset.json\") as f:\n",
        "    raw = json.load(f)\n",
        "\n",
        "def clean_series(card):\n",
        "    history = [p for p in card[\"price_history\"] if p[\"price\"] is not None]\n",
        "    history.sort(key=lambda p: p[\"date\"])\n",
        "    if len(history) < MIN_HISTORY:\n",
        "        return None\n",
        "    prices = [p[\"price\"] for p in history]\n",
        "    if np.median(prices) < MIN_PRICE:\n",
        "        return None\n",
        "    volumes = [(p.get(\"volume\") or 0) for p in history]\n",
        "    return prices, volumes\n",
        "\n",
        "cards = []\n",
        "for card in raw:\n",
        "    result = clean_series(card)\n",
        "    if result is not None:\n",
        "        prices, volumes = result\n",
        "        cards.append({\n",
        "            \"name\": card[\"name\"], \"set\": card[\"setName\"],\n",
        "            \"rarity\": card.get(\"rarity\") or \"Unknown\",\n",
        "            \"prices\": prices, \"volumes\": volumes,\n",
        "            \"full_length\": len(prices),  # proxy for how long this card has traded\n",
        "        })\n",
        "\n",
        "print(f\"Usable cards after cleaning: {len(cards)}\")\n",
        "\n",
        "all_rarities = sorted(set(c[\"rarity\"] for c in cards))\n",
        "rarity_to_num = {r: i for i, r in enumerate(all_rarities)}\n",
        "\n",
        "def pct_change(a, b):\n",
        "    if a == 0:\n",
        "        return 0.0\n",
        "    return (b - a) / a * 100\n",
        "\n",
        "def build_features(prices, volumes, cutoff, rarity, full_length):\n",
        "    window_p = prices[:cutoff]\n",
        "    window_v = volumes[:cutoff]\n",
        "    if len(window_p) < 60:\n",
        "        return None\n",
        "\n",
        "    current = window_p[-1]\n",
        "    p7, p30, p60 = window_p[-7], window_p[-30], window_p[-60]\n",
        "\n",
