      "cell_type": "code",
      "source": [
        "# ===========================================================================\n",
        "# POKEMON PREDICTOR — Price Model with CROSS-VALIDATION\n",
        "# Same features as v3, but evaluated with k-fold cross-validation for a\n",
        "# stable, honest performance number with a +/- range instead of one\n",
        "# lucky/unlucky split.\n",
        "# ===========================================================================\n",
        "\n",
        "import json\n",
        "import numpy as np\n",
        "from sklearn.metrics import mean_absolute_error, r2_score\n",
        "from sklearn.model_selection import KFold\n",
        "from sklearn.ensemble import GradientBoostingRegressor\n",
        "\n",
        "try:\n",
        "    from xgboost import XGBRegressor\n",
        "    HAVE_XGB = True\n",
        "except ImportError:\n",
        "    HAVE_XGB = False\n",
        "\n",
        "HORIZON_DAYS = 60\n",
        "MIN_HISTORY = 150\n",
        "MIN_PRICE = 1.00\n",
        "N_FOLDS = 5\n",
        "\n",
        "with open(\"price_history_dataset.json\") as f:\n",
        "    raw = json.load(f)\n",
        "\n",
        "def clean_series(card):\n",
        "    history = [p for p in card[\"price_history\"] if p[\"price\"] is not None]\n",
        "    history.sort(key=lambda p: p[\"date\"])\n",
        "    if len(history) < MIN_HISTORY:\n",
        "        return None\n",
        "    prices = [p[\"price\"] for p in history]\n",
        "    if np.median(prices) < MIN_PRICE:\n",
        "        return None\n",
        "    volumes = [(p.get(\"volume\") or 0) for p in history]\n",
        "    return prices, volumes\n",
        "\n",
        "cards = []\n",
        "for card in raw:\n",
        "    result = clean_series(card)\n",
        "    if result is not None:\n",
        "        prices, volumes = result\n",
        "        cards.append({\n",
        "            \"rarity\": card.get(\"rarity\") or \"Unknown\",\n",
        "            \"prices\": prices, \"volumes\": volumes, \"full_length\": len(prices),\n",
        "        })\n",
        "\n",
        "print(f\"Usable cards after cleaning: {len(cards)}\")\n",
        "\n",
        "all_rarities = sorted(set(c[\"rarity\"] for c in cards))\n",
        "rarity_to_num = {r: i for i, r in enumerate(all_rarities)}\n",
        "\n",
        "def pct_change(a, b):\n",
        "    return 0.0 if a == 0 else (b - a) / a * 100\n",
        "\n",
        "def build_features(prices, volumes, cutoff, rarity, full_length):\n",
        "    wp, wv = prices[:cutoff], volumes[:cutoff]\n",
        "    if len(wp) < 60:\n",
        "        return None\n",
        "    current = wp[-1]\n",
        "    p7, p30, p60 = wp[-7], wp[-30], wp[-60]\n",
        "    volatility = np.std(wp[-30:]) / (np.mean(wp[-30:]) + 1e-9)\n",
        "    avg_recent_vol = np.mean(wv[-30:]) if wv[-30:] else 0\n",
        "    avg_older_vol = np.mean(wv[-60:-30]) if wv[-60:-30] else 0\n",
        "    vol_trend = pct_change(avg_older_vol + 1, avg_recent_vol + 1)\n",
        "    acceleration = pct_change(p7, current) - pct_change(p30, p7)\n",
        "    hist_min, hist_max = min(wp), max(wp)\n",
        "    price_position = (current - hist_min) / (hist_max - hist_min + 1e-9)\n",
        "    long_drift = pct_change(wp[0], current)\n",
        "    return [\n",
        "        pct_change(p7, current), pct_change(p30, current), pct_change(p60, current),\n",
        "        volatility * 100, np.log(current + 1), avg_recent_vol, vol_trend,\n",
        "        acceleration, rarity_to_num[rarity], full_length, price_position, long_drift,\n",
        "    ]\n",
        "\n",
        "X, y = [], []\n",
        "for card in cards:\n",
        "    prices, volumes = card[\"prices\"], card[\"volumes\"]\n",
        "    cutoff = len(prices) - HORIZON_DAYS\n",
        "    if cutoff < 60:\n",
        "        continue\n",
        "    feats = build_features(prices, volumes, cutoff, card[\"rarity\"], card[\"full_length\"])\n",
        "    if feats is None:\n",
        "        continue\n",
        "    y.append(pct_change(prices[cutoff - 1], prices[cutoff - 1 + HORIZON_DAYS]))\n",
        "    X.append(feats)\n",
        "\n",
        "X = np.array(X)\n",
        "y = np.array(y)\n",
        "print(f\"Training examples: {len(X)}\\n\")\n",
        "\n",
        "def cross_validate(model_factory, label):\n",
        "    \"\"\"Runs k-fold CV and reports mean +/- std for R2 and error.\"\"\"\n",
        "    kf = KFold(n_splits=N_FOLDS, shuffle=True, random_state=42)\n",
        "    r2_scores, mae_scores, baseline_scores = [], [], []\n",
        "\n",
        "    for train_idx, test_idx in kf.split(X):\n",
        "        X_tr, X_te = X[train_idx], X[test_idx]\n",
        "        y_tr, y_te = y[train_idx], y[test_idx]\n",
        "\n",
        "        model = model_factory()\n",
        "        model.fit(X_tr, y_tr)\n",
        "        preds = model.predict(X_te)\n",
        "\n",
        "        r2_scores.append(r2_score(y_te, preds))\n",
        "        mae_scores.append(mean_absolute_error(y_te, preds))\n",
        "        baseline_scores.append(mean_absolute_error(y_te, np.zeros_like(y_te)))\n",
        "\n",
        "    r2_scores = np.array(r2_scores)\n",
        "    mae_scores = np.array(mae_scores)\n",
        "    print(f\"=== {label} ({N_FOLDS}-fold CV) ===\")\n",
        "    print(f\"  R^2:   {r2_scores.mean():.3f} +/- {r2_scores.std():.3f}\")\n",
        "    print(f\"  Error: {mae_scores.mean():.1f} +/- {mae_scores.std():.1f} pts\")\n",
        "    print(f\"  Baseline error: {np.mean(baseline_scores):.1f} pts\")\n",
        "    print(f\"  Per-fold R^2: {[round(s, 3) for s in r2_scores]}\")\n",
        "    print()\n",
        "    return r2_scores.mean()\n",
        "\n",
        "gb_r2 = cross_validate(\n",
        "    lambda: GradientBoostingRegressor(n_estimators=300, max_depth=3, learning_rate=0.03),\n",
        "    \"GradientBoosting\"\n",
        ")\n",
        "\n",
        "if HAVE_XGB:\n",
        "    xgb_r2 = cross_validate(\n",
        "        lambda: XGBRegressor(n_estimators=300, max_depth=3, learning_rate=0.03,\n",
        "                             subsample=0.8, colsample_bytree=0.8),\n",
        "        \"XGBoost\"\n",
        "    )\n",
        "\n",
        "# Train a final model on ALL data to save for use on the website\n",
        "print(\"Training final model on all data for deployment...\")\n",
        "if HAVE_XGB:\n",
        "    final = XGBRegressor(n_estimators=300, max_depth=3, learning_rate=0.03,\n",
        "                         subsample=0.8, colsample_bytree=0.8)\n",
        "else:\n",
        "    final = GradientBoostingRegressor(n_estimators=300, max_depth=3, learning_rate=0.03)\n",
        "final.fit(X, y)\n",
        "\n",
        "import pickle\n",
        "with open(\"price_model_final.pkl\", \"wb\") as f:\n",
        "    pickle.dump(final, f)\n",
        "print(\"Final model saved to price_model_final.pkl\")"
      ],
