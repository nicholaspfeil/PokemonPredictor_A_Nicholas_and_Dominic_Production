        "    return model, r2\n",
        "\n",
        "# Model A: GradientBoosting with the new features\n",
        "gb, gb_r2 = evaluate(\n",
        "    GradientBoostingRegressor(n_estimators=300, max_depth=3, learning_rate=0.03),\n",
        "    \"GradientBoosting + new features\"\n",
        ")\n",
