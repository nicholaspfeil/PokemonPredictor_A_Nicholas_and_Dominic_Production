      "cell_type": "code",
      "source": [
        "# Loads the trained model and generates future-price predictions for every\n",
        "# usable card, saving a clean JSON the website can display directly.\n",
        "#\n",
        "# For each card, we use ALL its available history (up to today) to compute\n",
        "# features, then predict the % price change over the next ~60 days.\n",
        "\n",
        "import json\n",
        "import pickle\n",
        "import numpy as np\n",
        "\n",
        "HORIZON_DAYS = 60\n",
        "MIN_HISTORY = 150\n",
        "MIN_PRICE = 1.00\n",
        "\n",
        "# --- Load data and model ---\n",
        "with open(\"price_history_dataset.json\") as f:\n",
        "    raw = json.load(f)\n",
        "\n",
        "with open(\"price_model_final.pkl\", \"rb\") as f:\n",
        "    model = pickle.load(f)\n",
        "\n",
        "# Rebuild the same rarity encoding used in training (must match!)\n",
        "def clean_series(card):\n",
        "    history = [p for p in card[\"price_history\"] if p[\"price\"] is not None]\n",
        "    history.sort(key=lambda p: p[\"date\"])\n",
        "    if len(history) < MIN_HISTORY:\n",
        "        return None\n",
        "    prices = [p[\"price\"] for p in history]\n",
        "    if np.median(prices) < MIN_PRICE:\n",
        "        return None\n",
        "    volumes = [(p.get(\"volume\") or 0) for p in history]\n",
        "    return prices, volumes\n",
        "\n",
        "usable = []\n",
        "for card in raw:\n",
        "    result = clean_series(card)\n",
        "    if result is not None:\n",
        "        prices, volumes = result\n",
        "        usable.append({\n",
        "            \"name\": card[\"name\"], \"set\": card[\"setName\"],\n",
        "            \"rarity\": card.get(\"rarity\") or \"Unknown\",\n",
        "            \"prices\": prices, \"volumes\": volumes, \"full_length\": len(prices),\n",
        "            \"image\": card.get(\"imageCdnUrl200\") or card.get(\"imageUrl\"),\n",
        "        })\n",
        "\n",
        "all_rarities = sorted(set(c[\"rarity\"] for c in usable))\n",
        "rarity_to_num = {r: i for i, r in enumerate(all_rarities)}\n",
        "\n",
        "def pct_change(a, b):\n",
        "    return 0.0 if a == 0 else (b - a) / a * 100\n",
        "\n",
        "def build_features(prices, volumes, cutoff, rarity, full_length):\n",
        "    wp, wv = prices[:cutoff], volumes[:cutoff]\n",
        "    if len(wp) < 60:\n",
        "        return None\n",
        "    current = wp[-1]\n",
        "    p7, p30, p60 = wp[-7], wp[-30], wp[-60]\n",
        "    volatility = np.std(wp[-30:]) / (np.mean(wp[-30:]) + 1e-9)\n",
        "    avg_recent_vol = np.mean(wv[-30:]) if wv[-30:] else 0\n",
        "    avg_older_vol = np.mean(wv[-60:-30]) if wv[-60:-30] else 0\n",
        "    vol_trend = pct_change(avg_older_vol + 1, avg_recent_vol + 1)\n",
        "    acceleration = pct_change(p7, current) - pct_change(p30, p7)\n",
        "    hist_min, hist_max = min(wp), max(wp)\n",
        "    price_position = (current - hist_min) / (hist_max - hist_min + 1e-9)\n",
        "    long_drift = pct_change(wp[0], current)\n",
        "    return [\n",
        "        pct_change(p7, current), pct_change(p30, current), pct_change(p60, current),\n",
        "        volatility * 100, np.log(current + 1), avg_recent_vol, vol_trend,\n",
        "        acceleration, rarity_to_num[rarity], full_length, price_position, long_drift,\n",
        "    ]\n",
        "\n",
        "# --- Generate a prediction for each card, using its FULL history ---\n",
        "predictions = []\n",
        "for card in usable:\n",
        "    prices, volumes = card[\"prices\"], card[\"volumes\"]\n",
        "    # use all history up to today (cutoff = full length)\n",
        "    feats = build_features(prices, volumes, len(prices), card[\"rarity\"], card[\"full_length\"])\n",
        "    if feats is None:\n",
        "        continue\n",
        "\n",
        "    predicted_change = float(model.predict(np.array([feats]))[0])\n",
        "    current_price = prices[-1]\n",
        "    predicted_price = current_price * (1 + predicted_change / 100)\n",
        "\n",
        "    predictions.append({\n",
        "        \"name\": card[\"name\"],\n",
        "        \"set\": card[\"set\"],\n",
        "        \"rarity\": card[\"rarity\"],\n",
        "        \"image\": card[\"image\"],\n",
        "        \"current_price\": round(current_price, 2),\n",
        "        \"predicted_change_pct\": round(predicted_change, 1),\n",
        "        \"predicted_price\": round(predicted_price, 2),\n",
        "    })\n",
        "\n",
        "# Sort by biggest predicted gain first\n",
        "predictions.sort(key=lambda p: p[\"predicted_change_pct\"], reverse=True)\n",
        "\n",
        "with open(\"card_predictions.json\", \"w\") as f:\n",
        "    json.dump(predictions, f, indent=2)\n",
        "\n",
        "print(f\"Generated predictions for {len(predictions)} cards.\")\n",
        "print(\"\\nTop 5 predicted gainers:\")\n",
        "for p in predictions[:5]:\n",
        "    print(f\"  {p['name']} ({p['set']}): {p['predicted_change_pct']:+.1f}% -> ${p['predicted_price']}\")\n",
        "print(\"\\nTop 5 predicted losers:\")\n",
        "for p in predictions[-5:]:\n",
        "    print(f\"  {p['name']} ({p['set']}): {p['predicted_change_pct']:+.1f}% -> ${p['predicted_price']}\")\n",
        "print(\"\\nSaved to card_predictions.json\")"
      ],
