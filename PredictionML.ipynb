        "    vol_trend = pct_change(avg_older_vol + 1, avg_recent_vol + 1)\n",
        "\n",
        "    momentum_recent = pct_change(p7, current)\n",
        "    momentum_older = pct_change(p30, p7)\n",
        "    acceleration = momentum_recent - momentum_older\n",
        "\n",
        "    # --- NEW v3: age / maturity features ---\n",
        "    # How long has this card been trading? (newer sets behave differently)\n",
        "    maturity = full_length\n",
        "    # Where does the current price sit vs the card's own historical range?\n",
        "    # (near its high = maybe overheated; near its low = maybe bottoming)\n",
        "    hist_min = min(window_p)\n",
